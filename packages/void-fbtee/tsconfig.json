{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2025", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "isolatedDeclarations": false,
    "types": ["vite/client", "fbtee/ReactTypes", "node"],
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUnusedLocals": true
  },
  "include": ["src", "test"]
}
