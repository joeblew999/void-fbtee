{
  "$schema": "https://raw.githubusercontent.com/vitejs/vite-plugin-registry/refs/heads/main/data/schema/extended-package-json.schema.json",
  "name": "void-fbtee",
  "version": "0.7.0",
  "description": "i18n for Void apps, as a Void add-on: fbtee strings, Temporal dates and Intl formatting, with a Vite plugin, Void middleware and React helpers",
  "keywords": [
    "cloudflare-workers",
    "fbtee",
    "i18n",
    "intl",
    "temporal",
    "vite-plugin",
    "void",
    "void-add-on"
  ],
  "homepage": "https://void-fbtee-example.gedw99.workers.dev",
  "bugs": {
    "url": "https://github.com/joeblew999/void-fbtee/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joeblew999/void-fbtee.git",
    "directory": "packages/void-fbtee"
  },
  "bin": {
    "void-fbtee": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "skills"
  ],
  "type": "module",
  "exports": {
    "./ai": "./dist/ai.mjs",
    "./client": "./dist/client.mjs",
    "./content": "./dist/content.mjs",
    "./crons/translations": "./dist/crons/translations.mjs",
    "./head": "./dist/head.mjs",
    "./locales": "./dist/locales.mjs",
    "./middleware": "./dist/middleware.mjs",
    "./plugin": "./dist/plugin.mjs",
    "./queues/translate": "./dist/queues/translate.mjs",
    "./react": "./dist/react.mjs",
    "./routes": "./dist/routes.mjs",
    "./server": "./dist/server.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vp pack --watch --no-clean",
    "build": "vp pack",
    "test": "vp test",
    "prepare": "vp pack",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@nkzw/fbtee-compiler": "6.0.1",
    "@nkzw/vite-plugin-fbtee": "6.0.1",
    "magicast": "0.5.5",
    "unhead": "3.4.3"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@cloudflare/workers-types": "catalog:",
    "@nkzw/eslint-plugin-fbtee": "6.0.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@vitejs/devtools": "0.8.3",
    "@vitejs/devtools-kit": "0.8.3",
    "@void/md": "catalog:",
    "@void/react": "catalog:",
    "fbtee": "6.0.1",
    "hono": "catalog:",
    "publint": "0.3.25",
    "react": "19.3.1",
    "temporal-polyfill": "1.0.8",
    "typescript": "7.0.2",
    "unplugin-unused": "0.6.0",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "void": "catalog:",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "@vitejs/devtools": "^0.8.3",
    "@void/react": "^1.7.0",
    "fbtee": "^6.0.0",
    "react": "^19.2.0",
    "temporal-polyfill": "^1.0.8",
    "vite": "^8.0.0",
    "void": "^1.7.0"
  },
  "peerDependenciesMeta": {
    "@vitejs/devtools": {
      "optional": true
    }
  },
  "engines": {
    "node": "^24.22.0 || >=26.12.0"
  },
  "compatiblePackages": {
    "schemaVersion": 1,
    "vite": {
      "type": "compatible",
      "versions": "^8.0.0",
      "note": "In Void apps on React only (Void, @void/react)"
    },
    "rollup": {
      "type": "incompatible",
      "reason": "A Vite plugin: it uses Vite-only hooks (the dev server, environments, configResolved), and without them would build without its checks"
    },
    "rolldown": {
      "type": "incompatible",
      "reason": "A Vite plugin: it uses Vite-only hooks (the dev server, environments, configResolved), and without them would build without its checks"
    }
  }
}
