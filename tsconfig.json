{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2025"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    // Libraries' own types still clash: Vitest's browser types and unplugin's with this
    // TypeScript (counted with skipLibCheck off, 2026-11-19).
    "skipLibCheck": true
  },
  "include": ["*.ts", "lint"]
}
