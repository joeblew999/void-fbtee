{
  "extends": "./.void/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["void/env", "fbtee/ReactTypes"],
    "jsx": "react-jsx",
    "lib": ["ES2025", "DOM", "DOM.Iterable"]
  },
  "include": ["src", "components", "pages", "routes", "middleware", "crons", "queues", "db", "i18n"]
}
