{
  "extends": "./.void/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["void/env", "fbtee/ReactTypes"],
    "jsx": "react-jsx",
    "lib": ["ES2025", "DOM", "DOM.Iterable"],
    "paths": {
      "@/*": ["./*"],
      "void/routes": ["./.void/routes.d.ts"],
      "void/db": ["./.void/db.d.ts"],
      "@schema": ["./db/schema.ts"],
      "@schema/*": ["./db/schema/*"]
    }
  },
  "include": [
    "src",
    "components",
    "lib",
    "pages",
    "routes",
    "middleware",
    "crons",
    "queues",
    "db",
    "i18n"
  ],
  "files": ["./.void/routes.d.ts", "./.void/db.d.ts"]
}
